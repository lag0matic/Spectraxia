<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\Spectraxia.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <SdrDriverDir Condition="'$(SdrDriverDir)' == ''">C:\sdrpp_windows_x64</SdrDriverDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\Spectraxia.ico" LogicalName="Spectraxia.Spectraxia.ico" />
    <EmbeddedResource Include="AdsbMap.json.gz" LogicalName="Spectraxia.AdsbMap" />
    <EmbeddedResource Include="AircraftReference.zip" LogicalName="Spectraxia.AircraftReference" />
    <None Update="hd-runtime\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="p25-runtime\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(SdrDriverDir)\rtlsdr.dll')">
    <None Include="$(SdrDriverDir)\rtlsdr.dll;$(SdrDriverDir)\libusb-1.0.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(SdrDriverDir)\pthreadVC2.dll" Condition="Exists('$(SdrDriverDir)\pthreadVC2.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(SdrDriverDir)\hackrf.dll')">
    <None Include="$(SdrDriverDir)\hackrf.dll" Link="hackrf.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
